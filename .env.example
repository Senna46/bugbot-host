# ============================================================
# bugbot-host Configuration
# ============================================================

# GitHub App ID (required)
# Reuse the same App as Fixooly so monitored repositories match.
BUGBOT_HOST_APP_ID=

# GitHub App Private Key (one of these is required)
BUGBOT_HOST_PRIVATE_KEY_PATH=
# BUGBOT_HOST_PRIVATE_KEY=

# Classic PAT as Senna46 (required)
# Used to create hosted PRs (author must be Senna46 for Bugbot),
# push hosted branches (so webhooks fire), and request reviews.
# Create at: https://github.com/settings/tokens (classic, repo scope)
BUGBOT_HOST_GITHUB_TOKEN=

# GitHub login whose PRs are NOT hosted (default: Senna46)
BUGBOT_HOST_AUTHOR_LOGIN=Senna46

# Polling interval in seconds (default: 120)
BUGBOT_HOST_POLL_INTERVAL=120

# Only host PRs created at or after this ISO 8601 timestamp.
# Closed PRs are never hosted. Already-open historical PRs are ignored.
# If unset, the first daemon run of this feature stores "now"
# and treats older open PRs as out of scope.
# BUGBOT_HOST_MIN_PR_CREATED_AT=2026-09-18T07:58:52Z

# Working directory for cloned repos (default: ~/.bugbot-host/repos)
BUGBOT_HOST_WORK_DIR=

# SQLite database path (default: ~/.bugbot-host/state.db)
BUGBOT_HOST_DB_PATH=

# Claude model override for merge-conflict resolution (optional)
BUGBOT_HOST_CLAUDE_MODEL=

# Log level: debug, info, warn, error (default: info)
BUGBOT_HOST_LOG_LEVEL=info

# ============================================================
# AI Authentication (needed to resolve merge conflicts)
# ============================================================

# Claude Code OAuth token (required on macOS Docker)
# Generate with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Or use Anthropic API key for pay-as-you-go
ANTHROPIC_API_KEY=
