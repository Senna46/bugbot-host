# ============================================================
# pr-shadow Configuration
# ============================================================

# GitHub App ID (required)
# Reuse the same App as Fixooly so monitored repositories match.
SHADOW_APP_ID=

# GitHub App Private Key (one of these is required)
SHADOW_PRIVATE_KEY_PATH=
# SHADOW_PRIVATE_KEY=

# Classic PAT as Senna46 (required)
# Used to create mirror PRs (author must be Senna46 for Bugbot),
# push shadow branches (so webhooks fire), and request reviews.
# Create at: https://github.com/settings/tokens (classic, repo scope)
SHADOW_GITHUB_TOKEN=

# GitHub login whose PRs are NOT mirrored (default: Senna46)
SHADOW_AUTHOR_LOGIN=Senna46

# Polling interval in seconds (default: 120)
SHADOW_POLL_INTERVAL=120

# Only mirror PRs created at or after this ISO 8601 timestamp.
# Closed PRs are never mirrored. Already-open historical PRs are ignored.
# If unset, the first daemon run of this feature stores "now"
# and treats older open PRs as out of scope.
# SHADOW_MIN_PR_CREATED_AT=2026-09-18T07:58:52Z

# Working directory for cloned repos (default: ~/.pr-shadow/repos)
SHADOW_WORK_DIR=

# SQLite database path (default: ~/.pr-shadow/state.db)
SHADOW_DB_PATH=

# Claude model override for merge-conflict resolution (optional)
SHADOW_CLAUDE_MODEL=

# Log level: debug, info, warn, error (default: info)
SHADOW_LOG_LEVEL=info

# ============================================================
# AI Authentication (needed to resolve merge conflicts)
# ============================================================

# Claude Code OAuth token (required on macOS Docker)
# Generate with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Or use Anthropic API key for pay-as-you-go
ANTHROPIC_API_KEY=
